# -----------------------------------------------------------------------------
# PanoVeya environment variables
# Copy this file to `.env.local` for local development:  cp .env.example .env.local
# On Vercel, add the same keys under Project → Settings → Environment Variables.
# Never commit real secrets. `.env*` files are git-ignored (except this example).
# -----------------------------------------------------------------------------

# Public production URL, without a trailing slash. Used for canonical URLs,
# Open Graph tags, sitemap.xml, robots.txt, structured data and llms.txt.
# If unset on Vercel, the project's production *.vercel.app domain is used.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Lead delivery (Resend) --------------------------------------------------
# All three are required for the enquiry and photographer forms to deliver.
# If any is missing, the forms show an honest "not connected yet" message and
# NOTHING is sent — submissions are never silently discarded or faked.

# Server-only API key from https://resend.com/api-keys (starts with "re_").
RESEND_API_KEY=

# Sender address on a domain you have verified in Resend.
# Example: PanoVeya Leads <leads@yourdomain.com>
LEAD_NOTIFICATION_FROM=

# Where new leads are delivered. Comma-separate multiple addresses.
# Example: founder@yourdomain.com,sales@yourdomain.com
LEAD_NOTIFICATION_TO=
